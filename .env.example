# ─────────────────────────────────────────────────────────────────────────────
# Football RAG SaaS — environment template
# Copy to `.env` and fill in real values. `.env` is git-ignored — never commit it.
# ─────────────────────────────────────────────────────────────────────────────

# App Config
DEBUG=True
APP_NAME="Football RAG SaaS API"

# PostgreSQL DSN
POSTGRES_DSN=

# Knowledge Graph Provider (postgres | neo4j)
KG_PROVIDER=postgres

# Authentication — generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=
ACCESS_TOKEN_EXPIRE_MINUTES=

# CORS Origins (comma separated list or * for all)
CORS_ORIGINS=*

# Default Supervisor Account (seeded if database is empty on start)
FOOTBALL_ADMIN_USERNAME=admin
FOOTBALL_ADMIN_EMAIL=admin@football.com
FOOTBALL_ADMIN_PASSWORD=AdminPass123!

# ─────────────────────────────────────────────────────────────────────────────
# LLM Provider API keys (secrets — keep in .env only)
#
# Priority: environment variable > llm_config.yaml providers.<name>.api_key
# (yaml fields should stay empty; keep keys here).
# ─────────────────────────────────────────────────────────────────────────────

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Anthropic Claude (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# HuggingFace token — only needed for private/gated repos
# (also read as HUGGINGFACE_HUB_TOKEN)
HF_TOKEN=

# Ollama needs no key — runs locally (default model in llm_config.yaml)
