# App Config
DEBUG=True
APP_NAME="Football RAG SaaS API"

# PostgreSQL DSN
POSTGRES_DSN=postgresql://postgres:123@localhost:5432/football_rag

# Knowledge Graph Provider (postgres | neo4j)
KG_PROVIDER=postgres

# Authentication
JWT_SECRET_KEY=some-super-random-cryptographically-secure-string-2026-football
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Origins (comma separated list or * for all)
CORS_ORIGINS=*

# Default Supervisor Account (seeded if database is empty on start)
FOOTBALL_ADMIN_USERNAME=admin
FOOTBALL_ADMIN_EMAIL=admin@football.com
FOOTBALL_ADMIN_PASSWORD=AdminPass123!
